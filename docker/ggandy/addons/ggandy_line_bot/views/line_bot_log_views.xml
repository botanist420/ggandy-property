<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggandy_line_bot_log_search" model="ir.ui.view">
        <field name="name">ggandy.line.bot.log.search</field>
        <field name="model">ggandy.line.bot.log</field>
        <field name="arch" type="xml">
            <search string="搜尋 LINE 紀錄">
                <field name="partner_id"/>
                <field name="line_user_id"/>
                <field name="command"/>
                <field name="message_text"/>
                <filter name="ignored" string="待真人回覆（忽略）" domain="[('status', '=', 'ignored'), ('event_type', '=', 'message')]"/>
                <filter name="unbound" string="未綁定／綁定失敗" domain="[('status', 'in', ('unbound', 'bind_failed'))]"/>
                <filter name="errors" string="錯誤" domain="[('status', '=', 'error')]"/>
                <group>
                    <filter name="group_status" string="處理結果" context="{'group_by': 'status'}"/>
                    <filter name="group_partner" string="房客" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_day" string="日期" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ggandy_line_bot_log_list" model="ir.ui.view">
        <field name="name">ggandy.line.bot.log.list</field>
        <field name="model">ggandy.line.bot.log</field>
        <field name="arch" type="xml">
            <list string="LINE Bot 紀錄" create="0" edit="0" delete="0"
                  decoration-danger="status == 'error'"
                  decoration-warning="status in ('unbound', 'bind_failed')">
                <field name="create_date" string="時間"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('replied', 'bound')"
                       decoration-warning="status in ('unbound', 'bind_failed')"
                       decoration-danger="status == 'error'"/>
                <field name="event_type" optional="hide"/>
                <field name="command"/>
                <field name="partner_id"/>
                <field name="message_text" optional="show"/>
                <field name="line_user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ggandy_line_bot_log_form" model="ir.ui.view">
        <field name="name">ggandy.line.bot.log.form</field>
        <field name="model">ggandy.line.bot.log</field>
        <field name="arch" type="xml">
            <form string="LINE Bot 紀錄" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="LINE">
                            <field name="create_date"/>
                            <field name="webhook_event_id"/>
                            <field name="event_type"/>
                            <field name="line_user_id"/>
                        </group>
                        <group string="Odoo">
                            <field name="status"/>
                            <field name="command"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="收到的訊息">
                        <field name="message_text" nolabel="1"/>
                    </group>
                    <group string="Bot 回覆">
                        <field name="response_text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ggandy_line_bot_log" model="ir.actions.act_window">
        <field name="name">LINE 紀錄</field>
        <field name="res_model">ggandy.line.bot.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ggandy_line_bot_log_search"/>
    </record>

    <menuitem id="menu_ggandy_line_bot"
              name="LINE"
              parent="ggandy_property_management.menu_ggandy_root"
              sequence="85"
              groups="ggandy_property_management.group_property_manager"/>
    <menuitem id="menu_ggandy_line_bot_log"
              name="訊息紀錄"
              parent="menu_ggandy_line_bot"
              action="action_ggandy_line_bot_log"
              sequence="10"/>
    <menuitem id="menu_ggandy_line_bound_partners"
              name="已綁定房客"
              parent="menu_ggandy_line_bot"
              action="action_ggandy_line_bound_partners"
              sequence="20"/>
</odoo>
