<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ggandy_line_bot" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ggandy.line.bot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ggandy_property_management.res_config_settings_view_form_ggandy"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ggandy_modules']" position="after">
                <block title="LINE 房客 Bot" name="ggandy_line_bot_settings">
                    <setting id="ggandy_line_channel"
                             string="官方帳號連線"
                             help="Channel secret 與 token 只儲存在 Odoo 系統參數，不會寫入模組或 Git。請妥善保管，不要貼到公開訊息或文件中。">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="ggandy_line_channel_secret" class="col-lg-3 o_light_label"/>
                                <field name="ggandy_line_channel_secret" password="True" class="oe_inline"/>
                            </div>
                            <div class="row mt8">
                                <label for="ggandy_line_channel_access_token" class="col-lg-3 o_light_label"/>
                                <field name="ggandy_line_channel_access_token" password="True" class="oe_inline"/>
                            </div>
                            <div class="row mt8" invisible="not ggandy_line_bot_basic_id">
                                <label for="ggandy_line_bot_display_name" class="col-lg-3 o_light_label"/>
                                <div class="col">
                                    <field name="ggandy_line_bot_display_name" class="oe_inline"/>
                                    <field name="ggandy_line_bot_basic_id" class="oe_inline ms-2"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <button name="action_test_ggandy_line_connection"
                                        type="object"
                                        string="測試 LINE 連線"
                                        class="btn-secondary"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="ggandy_line_webhook"
                             string="Webhook"
                             help="把這個網址貼到 LINE Developers Console →「Messaging API」→ Webhook URL，按 Verify 後開啟 Use webhook。">
                        <field name="ggandy_line_webhook_url" widget="CopyClipboardChar"/>
                    </setting>
                    <setting id="ggandy_line_bindings"
                             string="房客綁定"
                             help="更換成另一個 LINE 官方帳號時，舊帳號的綁定在新帳號都認不得，要先清除，再請房客用新帳號重新綁定。">
                        <div class="content-group">
                            <div class="mt8">
                                <field name="ggandy_line_bound_count" class="oe_inline"/> 位房客已綁定
                            </div>
                            <div class="mt8">
                                <button name="action_clear_ggandy_line_bindings"
                                        type="object"
                                        string="清除所有 LINE 綁定"
                                        class="btn-secondary"
                                        icon="fa-trash"
                                        confirm="所有房客的 LINE 綁定都會被清除，要重新傳綁定碼才能使用。只在更換官方帳號時使用，確定要清除嗎？"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
