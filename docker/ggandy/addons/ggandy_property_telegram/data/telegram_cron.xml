<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_poll_telegram_updates" model="ir.cron">
        <field name="name">GGAndy Telegram：接收管理員指令</field>
        <field name="model_id" ref="model_ggandy_telegram_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_updates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_send_overdue_rent_digest" model="ir.cron">
        <field name="name">GGAndy Telegram：逾期租金摘要</field>
        <field name="model_id" ref="model_ggandy_telegram_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_overdue_rent_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
