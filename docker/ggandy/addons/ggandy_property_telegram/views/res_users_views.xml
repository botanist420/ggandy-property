<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_ggandy_telegram" model="ir.ui.view">
        <field name="name">res.users.form.ggandy.telegram</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="GGAndy Telegram" name="ggandy_telegram"
                      groups="ggandy_property_management.group_property_manager">
                    <div class="o_ggandy_hint">
                        <i class="fa fa-info-circle" role="img" title="說明"/>
                        <div>
                            <div>要同時<strong>啟用</strong>、填好 <strong>Telegram User ID</strong>，並具「包租代管／管理員」權限，才能操作 Bot。</div>
                        </div>
                    </div>
                    <group>
                        <group string="授權">
                            <field name="telegram_enabled"/>
                            <field name="telegram_user_id"
                                   placeholder="例如：123456789"
                                   readonly="not telegram_enabled"/>
                        </group>
                        <group string="連線狀態">
                            <field name="telegram_username"/>
                            <field name="telegram_chat_id"/>
                            <field name="telegram_last_seen"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>

