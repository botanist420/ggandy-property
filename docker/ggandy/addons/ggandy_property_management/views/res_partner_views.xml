<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ggandy_property" model="ir.ui.view">
        <field name="name">res.partner.form.ggandy.property</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ggandy_properties" type="object" class="oe_stat_button" icon="fa-building" invisible="ggandy_property_count == 0">
                    <field name="ggandy_property_count" widget="statinfo" string="持有物件"/>
                </button>
                <button name="action_view_ggandy_owner_contracts" type="object" class="oe_stat_button" icon="fa-handshake-o" invisible="ggandy_owner_contract_count == 0">
                    <field name="ggandy_owner_contract_count" widget="statinfo" string="房東合約"/>
                </button>
                <button name="action_view_ggandy_leases" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="ggandy_lease_count == 0">
                    <field name="ggandy_lease_count" widget="statinfo" string="房客租約"/>
                </button>
                <button name="action_view_ggandy_maintenance" type="object" class="oe_stat_button" icon="fa-wrench" invisible="ggandy_maintenance_count == 0">
                    <field name="ggandy_maintenance_count" widget="statinfo" string="報修單"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="包租代管" name="ggandy_property_management">
                    <div class="o_ggandy_hint">
                        <i class="fa fa-info-circle" role="img" title="說明"/>
                        <div>
                            <div>同一位聯絡人可以同時是<strong>房東、房客與合作廠商</strong>；建立合約、租約、報修單、整備採購時會自動勾選。</div>
                        </div>
                    </div>
                    <group string="身分類型">
                        <field name="is_ggandy_owner"/>
                        <field name="is_ggandy_tenant"/>
                        <field name="is_ggandy_vendor"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_ggandy_owner" model="ir.actions.act_window">
        <field name="name">房東</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_ggandy_owner', '=', True)]</field>
        <field name="context">{'default_is_ggandy_owner': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">還沒有房東</p>
            <p>建立物件或房東合約時選了房東，就會自動出現在這裡。</p>
        </field>
    </record>
    <record id="action_ggandy_tenant" model="ir.actions.act_window">
        <field name="name">房客</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_ggandy_tenant', '=', True)]</field>
        <field name="context">{'default_is_ggandy_tenant': True, 'default_company_type': 'person'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">還沒有房客</p>
            <p>建立房客租約時選了房客，就會自動出現在這裡。</p>
        </field>
    </record>
    <record id="action_ggandy_vendor" model="ir.actions.act_window">
        <field name="name">合作廠商</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_ggandy_vendor', '=', True)]</field>
        <field name="context">{'default_is_ggandy_vendor': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">還沒有合作廠商</p>
            <p>報修單或整備採購選了廠商，就會自動出現在這裡。</p>
        </field>
    </record>
</odoo>
