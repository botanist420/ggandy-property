<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggandy_accounting_overview_search" model="ir.ui.view">
        <field name="name">ggandy.accounting.overview.search</field>
        <field name="model">ggandy.accounting.overview</field>
        <field name="arch" type="xml">
            <search string="搜尋 GGAndy 帳務">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="owner_id"/>
                <filter name="current_month" string="本月"
                        domain="[('period_start', '=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="previous_month" string="上月"
                        domain="[('period_start', '=', (context_today() + relativedelta(day=1, months=-1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="uncollected_rent" string="租金未收" domain="[('has_uncollected_rent', '=', True)]"/>
                <filter name="owner_unpaid" string="待付房東" domain="[('has_owner_unpaid', '=', True)]"/>
                <filter name="negative_earned" string="已經賺到為負" domain="[('has_negative_earned', '=', True)]"/>
                <group>
                    <filter name="group_period" string="月份" context="{'group_by': 'period_start:month'}"/>
                    <filter name="group_property" string="物件" context="{'group_by': 'property_id'}"/>
                    <filter name="group_unit" string="房間" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_owner" string="房東" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ggandy_accounting_overview_list" model="ir.ui.view">
        <field name="name">ggandy.accounting.overview.list</field>
        <field name="model">ggandy.accounting.overview</field>
        <field name="arch" type="xml">
            <list string="GGAndy 帳務總表" create="0" edit="0" delete="0">
                <field name="period_start" string="月份"/>
                <field name="property_id"/>
                <field name="unit_id" context="{'ggandy_unit_short_name': True}"/>
                <field name="owner_id"/>
                <field name="rent_receivable" sum="租金應收"/>
                <field name="rent_collected" sum="租金實收" decoration-warning="rent_uncollected &gt; 0"/>
                <field name="owner_payable" sum="應付房東"/>
                <field name="owner_paid" sum="已付房東" decoration-warning="owner_unpaid &gt; 0"/>
                <field name="expected_profit" sum="預計賺"/>
                <field name="earned_profit" sum="已經賺到" decoration-danger="earned_profit &lt; 0"/>
                <field name="rent_uncollected" column_invisible="True"/>
                <field name="owner_unpaid" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ggandy_accounting_overview_form" model="ir.ui.view">
        <field name="name">ggandy.accounting.overview.form</field>
        <field name="model">ggandy.accounting.overview</field>
        <field name="arch" type="xml">
            <form string="GGAndy 帳務" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="期間與物件">
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="property_id"/>
                            <field name="unit_id" context="{'ggandy_unit_short_name': True}"/>
                            <field name="owner_id"/>
                            <field name="active_owner_contract_id"/>
                        </group>
                        <group string="公司">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="老闆總覽">
                        <group>
                            <field name="rent_receivable"/>
                            <field name="rent_collected"/>
                            <field name="rent_uncollected"/>
                        </group>
                        <group>
                            <field name="owner_payable"/>
                            <field name="owner_paid"/>
                            <field name="owner_unpaid"/>
                            <field name="expected_profit"/>
                            <field name="earned_profit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ggandy_accounting_overview" model="ir.actions.act_window">
        <field name="name">營運總表</field>
        <field name="res_model">ggandy.accounting.overview</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ggandy_accounting_overview_search"/>
        <field name="context">{'search_default_current_month': 1, 'search_default_group_property': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">目前沒有帳務資料</p>
            <p>每個啟用中的房間每個月會自動有一列，金額即時從收租明細與帳單算出，不需要手動更新。</p>
        </field>
    </record>

    <record id="action_ggandy_overdue_rent_schedule" model="ir.actions.act_window">
        <field name="name">逾期未收</field>
        <field name="res_model">ggandy.rent.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ggandy_rent_schedule_search"/>
        <field name="context">{'search_default_overdue': 1, 'search_default_group_property': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">目前沒有逾期未收的租金</p>
            <p>生效中租約的收租明細過了繳款期限、帳單還沒收齊，就會出現在這裡。</p>
        </field>
    </record>

    <record id="action_ggandy_owner_unpaid_bill" model="ir.actions.act_window">
        <field name="name">待付房東</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('ggandy_owner_contract_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">目前沒有待付給房東的帳單</p>
            <p>房東合約每月自動建立的 Vendor Bill，還沒付清的會列在這裡；拿掉「待付款」篩選可以看全部。</p>
        </field>
    </record>

    <menuitem id="menu_ggandy_accounting"
              name="GGandy帳務"
              parent="menu_ggandy_root"
              sequence="80"
              groups="ggandy_property_management.group_property_user"/>
    <menuitem id="menu_ggandy_accounting_overview"
              name="營運總表"
              parent="menu_ggandy_accounting"
              action="action_ggandy_accounting_overview"
              sequence="10"/>
    <menuitem id="menu_ggandy_overdue_rent_schedule"
              name="逾期未收"
              parent="menu_ggandy_accounting"
              action="action_ggandy_overdue_rent_schedule"
              sequence="20"/>
    <menuitem id="menu_ggandy_owner_unpaid_bill"
              name="待付房東"
              parent="menu_ggandy_accounting"
              action="action_ggandy_owner_unpaid_bill"
              groups="account.group_account_invoice"
              sequence="30"/>
</odoo>
