<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggandy_property_unit_search" model="ir.ui.view">
        <field name="name">ggandy.property.unit.search</field>
        <field name="model">ggandy.property.unit</field>
        <field name="arch" type="xml">
            <search string="搜尋房間">
                <field name="name"/>
                <field name="property_id"/>
                <filter name="vacant" string="空房" domain="[('state', '=', 'vacant')]"/>
                <filter name="occupied" string="已出租" domain="[('state', '=', 'occupied')]"/>
                <filter name="maintenance" string="維修中" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter name="archived" string="已封存" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_property" string="物件" context="{'group_by': 'property_id'}"/>
                    <filter name="group_state" string="出租狀態" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="房間類型" context="{'group_by': 'unit_type'}"/>
                    <filter name="group_electricity_billing" string="電費計費方式" context="{'group_by': 'electricity_billing_type'}"/>
                    <filter name="group_water_billing" string="水費計費方式" context="{'group_by': 'water_billing_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ggandy_property_unit_list" model="ir.ui.view">
        <field name="name">ggandy.property.unit.list</field>
        <field name="model">ggandy.property.unit</field>
        <field name="arch" type="xml">
            <list string="房間" multi_edit="1" decoration-muted="not active">
                <field name="property_id"/>
                <field name="name"/>
                <field name="unit_type"/>
                <field name="floor" optional="show"/>
                <field name="area" optional="show"/>
                <field name="monthly_rent" widget="monetary"/>
                <field name="electricity_billing_type" optional="hide"/>
                <field name="electricity_rate" optional="hide"/>
                <field name="water_billing_type" optional="hide"/>
                <field name="water_fixed_fee" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'occupied'"
                       decoration-warning="state == 'maintenance'"
                       decoration-info="state == 'reserved'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ggandy_property_unit_form" model="ir.ui.view">
        <field name="name">ggandy.property.unit.form</field>
        <field name="model">ggandy.property.unit</field>
        <field name="arch" type="xml">
            <form string="房間">
                <header>
                    <field name="has_open_lease" invisible="1"/>
                    <button name="action_create_lease" type="object" string="新增房客租約" class="btn-primary"
                            invisible="has_open_lease"
                            help="這間房目前沒有草稿或生效中的租約，按這裡直接建立新租約，月租、押金會自動帶入。"/>
                    <button name="action_create_lease" type="object" string="新增房客租約" class="btn-secondary"
                            invisible="not has_open_lease"
                            help="這間房已有草稿或生效中的租約；續約或預訂下一位房客時仍可在這裡建立新租約。"/>
                    <field name="state" widget="statusbar" statusbar_visible="vacant,reserved,occupied,maintenance,inactive" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lease_count" widget="statinfo" string="房客租約"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="報修單"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="例如：3F-A 或 101 房"/></h1>
                    </div>
                    <group>
                        <group string="基本資料">
                            <field name="property_id"/>
                            <field name="unit_type"/>
                            <field name="floor"/>
                            <field name="area"/>
                        </group>
                        <group string="格局與租金">
                            <field name="bedroom_count"/>
                            <field name="bathroom_count"/>
                            <field name="monthly_rent"/>
                            <field name="deposit_months"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group name="utility_fees">
                        <group string="電費">
                            <field name="electricity_billing_type"/>
                            <field name="electricity_rate" invisible="electricity_billing_type != 'metered'"/>
                            <field name="electricity_fixed_fee" invisible="electricity_billing_type != 'fixed'"/>
                            <field name="electricity_meter_ref" invisible="electricity_billing_type in ('included', 'fixed')"/>
                        </group>
                        <group string="水費">
                            <field name="water_billing_type"/>
                            <field name="water_rate" invisible="water_billing_type != 'metered'"/>
                            <field name="water_fixed_fee" invisible="water_billing_type != 'fixed'"/>
                            <field name="water_meter_ref" invisible="water_billing_type in ('included', 'fixed')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="租約紀錄" name="lease_history">
                            <field name="lease_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="rent_amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="水電表維護" name="meter_readings">
                            <div class="o_ggandy_hint">
                                <i class="fa fa-info-circle" role="img" title="說明"/>
                                <div>
                                    <div><strong>電表月份</strong>是這期帳單收哪個月的電費，例如 10 月帳單收 9 月電費。</div>
                                    <div><strong>水費</strong>是那一期帳單收的固定水費，只改那一期；要改之後每個月的金額請改上方的水費設定。</div>
                                    <div>抄表度數填該月月底讀數，填好會帶到下一期並更新草稿帳單，已過帳不能改。</div>
                                </div>
                            </div>
                            <field name="meter_schedule_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0" default_order="period_start desc">
                                    <field name="meter_month" width="90px"/>
                                    <field name="period_month" optional="hide" width="90px"/>
                                    <field name="tenant_id" optional="hide"/>
                                    <field name="electricity_billing_type" column_invisible="True"/>
                                    <field name="electricity_prev_reading" string="上期度數" optional="show" width="100px"
                                           invisible="electricity_billing_type != 'metered'" readonly="invoice_state == 'posted'"/>
                                    <field name="electricity_curr_reading" string="抄表度數" width="100px"
                                           invisible="electricity_billing_type != 'metered'" readonly="invoice_state == 'posted'"/>
                                    <field name="electricity_usage" optional="show" width="90px"
                                           invisible="electricity_billing_type != 'metered'"/>
                                    <field name="electricity_amount" width="100px"/>
                                    <field name="water_billing_type" column_invisible="True"/>
                                    <field name="water_fixed_fee" string="水費" width="100px"
                                           invisible="water_billing_type != 'fixed'" readonly="invoice_state == 'posted'"/>
                                    <field name="water_curr_reading" string="水錶度數" optional="hide" width="100px"
                                           invisible="water_billing_type != 'metered'" readonly="invoice_state == 'posted'"/>
                                    <field name="note" string="備註" optional="show" placeholder="例如：換電錶"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="invoice_state" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="格局照片" name="layout_photos">
                            <div class="o_ggandy_hint">
                                <i class="fa fa-info-circle" role="img" title="說明"/>
                                <div>
                                    <div>用下方 chatter 的<strong>迴紋針</strong>上傳圖片，就會自動出現在這裡。</div>
                                </div>
                            </div>
                            <field name="layout_photo_ids" readonly="1" nolabel="1">
                                <kanban create="0" edit="0">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <templates>
                                        <t t-name="card" class="o_ggandy_photo_card">
                                            <a class="o_ggandy_photo_thumb" t-attf-href="/web/image/#{record.id.raw_value}?download=false" target="_blank">
                                                <img t-attf-src="/web/image/#{record.id.raw_value}/512x384" t-att-alt="record.name.value"/>
                                            </a>
                                            <field name="name" class="fw-bold text-truncate"/>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="維修紀錄" name="maintenance_history">
                            <field name="maintenance_request_ids" readonly="1">
                                <list default_order="request_date desc, id desc">
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="request_date"/>
                                    <field name="category"/>
                                    <field name="vendor_id"/>
                                    <field name="actual_cost"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state in ('assigned', 'waiting')"
                                           decoration-info="state == 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                        <page string="維修照片" name="maintenance_photos">
                            <div class="o_ggandy_hint">
                                <i class="fa fa-info-circle" role="img" title="說明"/>
                                <div>
                                    <div>彙整這間房<strong>所有報修單</strong>的照片，依通報時間由新到舊。</div>
                                    <div>要新增照片，請到該報修單的 chatter 上傳。</div>
                                </div>
                            </div>
                            <field name="maintenance_photo_ids" readonly="1" nolabel="1">
                                <kanban create="0" edit="0">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="res_name"/>
                                    <field name="ggandy_request_date"/>
                                    <templates>
                                        <t t-name="card" class="o_ggandy_photo_card">
                                            <a class="o_ggandy_photo_thumb" t-attf-href="/web/image/#{record.id.raw_value}?download=false" target="_blank">
                                                <img t-attf-src="/web/image/#{record.id.raw_value}/512x384" t-att-alt="record.name.value"/>
                                            </a>
                                            <field name="name" class="fw-bold text-truncate"/>
                                            <div class="o_ggandy_photo_meta text-truncate"><field name="res_name"/></div>
                                            <div class="o_ggandy_photo_meta"><field name="ggandy_request_date"/></div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="備註" name="notes">
                            <field name="note" placeholder="房間設備、鑰匙、注意事項等……"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ggandy_property_unit" model="ir.actions.act_window">
        <field name="name">房間</field>
        <field name="res_model">ggandy.property.unit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ggandy_property_unit_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一個房間</p>
            <p>房間可以是一間套房、一戶、一個店面或車位。</p>
        </field>
    </record>
</odoo>
