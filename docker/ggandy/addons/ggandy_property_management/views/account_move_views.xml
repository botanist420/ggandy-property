<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ggandy_property" model="ir.ui.view">
        <field name="name">account.move.form.ggandy.property</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ggandy_recompute_owner_bill" type="object" string="重新計算房東帳單"
                        invisible="not ggandy_owner_contract_id or not ggandy_settlement_period_start or state == 'cancel'"
                        help="依同一個帳單月份重算：保底租金（代管是已收到的租金扣代管費）＋管理費＋網路第四台＋電費＋水費。草稿帳單的明細會整批換成新算出來的（手動改過的會被覆蓋）；已過帳的帳單不會自動調整，只會告訴你差多少。"/>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="ggandy_lease_id" invisible="move_type not in ('out_invoice', 'out_refund')" readonly="state != 'draft'"/>
                <field name="ggandy_property_id" invisible="not ggandy_lease_id"/>
                <field name="ggandy_unit_id" invisible="not ggandy_lease_id"/>
                <field name="ggandy_owner_contract_id" invisible="move_type not in ('in_invoice', 'in_refund')" readonly="state != 'draft'"/>
                <field name="ggandy_owner_property_id" invisible="not ggandy_owner_contract_id"/>
                <field name="ggandy_expense_property_id" invisible="move_type not in ('in_invoice', 'in_refund')" readonly="state != 'draft'"/>
                <field name="ggandy_expense_unit_id" invisible="not ggandy_expense_property_id" readonly="state != 'draft'"/>
                <field name="ggandy_expense_kind" invisible="not ggandy_expense_property_id" readonly="state != 'draft'"/>
                <field name="ggandy_settlement_period_start" invisible="not ggandy_owner_contract_id" readonly="state != 'draft'"/>
                <field name="ggandy_settlement_period_end" invisible="not ggandy_owner_contract_id" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
