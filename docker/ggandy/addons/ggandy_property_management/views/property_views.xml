<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggandy_property_search" model="ir.ui.view">
        <field name="name">ggandy.property.search</field>
        <field name="model">ggandy.property</field>
        <field name="arch" type="xml">
            <search string="搜尋物件">
                <field name="name"/>
                <field name="code"/>
                <field name="owner_id"/>
                <field name="manager_id"/>
                <field name="address_display"/>
                <filter name="master_lease" string="包租" domain="[('management_mode', '=', 'master_lease')]"/>
                <filter name="agency" string="代管" domain="[('management_mode', '=', 'agency')]"/>
                <separator/>
                <filter name="archived" string="已封存" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_owner" string="房東" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_manager" string="管理人員" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_mode" string="經營模式" context="{'group_by': 'management_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ggandy_property_list" model="ir.ui.view">
        <field name="name">ggandy.property.list</field>
        <field name="model">ggandy.property</field>
        <field name="arch" type="xml">
            <list string="物件" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="management_mode" widget="badge"
                       decoration-info="management_mode == 'agency'"
                       decoration-success="management_mode == 'master_lease'"/>
                <field name="owner_id"/>
                <field name="address_display" optional="show"/>
                <field name="manager_id" widget="many2one_avatar_user" optional="show"/>
                <field name="owner_payment_day" optional="show"/>
                <field name="unit_count" string="房間數" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ggandy_property_form" model="ir.ui.view">
        <field name="name">ggandy.property.form</field>
        <field name="model">ggandy.property</field>
        <field name="arch" type="xml">
            <form string="物件">
                <header>
                    <button name="action_open_quick_meter_reading" type="object" string="快速抄表" class="btn-secondary"
                            invisible="not unit_ids"
                            help="把 Google Sheet 某個月的房號與電表度數整列貼上，一次寫進各房間的租金期次。"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="已封存" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="unit_count" widget="statinfo" string="房間"/>
                        </button>
                        <button name="action_view_owner_contracts" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="owner_contract_count" widget="statinfo" string="房東合約"/>
                        </button>
                        <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lease_count" widget="statinfo" string="房客租約"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="報修單"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="例如：大安信義館"/></h1>
                        <div><field name="code" class="oe_inline"/></div>
                    </div>
                    <group>
                        <group string="管理資訊">
                            <field name="management_mode" widget="radio"/>
                            <field name="property_type"/>
                            <field name="owner_id" context="{'default_is_ggandy_owner': True}"/>
                            <field name="manager_id" widget="many2one_avatar_user"/>
                            <field name="owner_payment_day"/>
                        </group>
                        <group string="地址">
                            <field name="state_id" domain="[('country_id', '=', country_id)]"/>
                            <field name="city_id" domain="[('state_id', '=', state_id)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="zip"/>
                            <field name="street" placeholder="路、街、段、巷、弄、號"/>
                            <field name="street2"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="管理期間">
                            <field name="acquisition_date"/>
                            <field name="management_end_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="本月收租概覽" name="month_income">
                            <field name="month_summary_label"/>
                            <field name="month_rent_total"/>
                            <field name="month_management_fee_total"/>
                            <field name="internet_fee"/>
                            <field name="month_electricity_total"/>
                            <field name="month_water_total"/>
                            <div colspan="2" class="border-top my-1"/>
                            <field name="month_income_total" class="fw-bold"/>
                            <field name="month_owner_payout"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="房間" name="units">
                            <field name="unit_ids" context="{'default_property_id': id}">
                                <list editable="bottom">
                                    <control>
                                        <create string="新增房間"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="unit_type" optional="hide"/>
                                    <field name="floor" optional="hide"/>
                                    <field name="area" optional="hide"/>
                                    <field name="monthly_rent" widget="monetary"/>
                                    <field name="electricity_billing_type" column_invisible="True"/>
                                    <field name="electricity_rate" optional="show"
                                           invisible="electricity_billing_type != 'metered'"/>
                                    <field name="water_billing_type" column_invisible="True"/>
                                    <field name="water_fixed_fee" widget="monetary" optional="show"
                                           invisible="water_billing_type != 'fixed'"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'occupied'"
                                           decoration-warning="state == 'maintenance'"
                                           decoration-info="state == 'reserved'"/>
                                    <button name="action_open_unit" type="object" string="房間" icon="fa-home"
                                            class="btn-link o_ggandy_icon_tight" title="開啟房間資料"/>
                                    <button name="action_view_current_lease" type="object" string="租約帳單" icon="fa-file-text-o"
                                            class="btn-link o_ggandy_icon_tight" title="開啟這間房目前的租約，可在租金期次分頁修改管理費、帳單等"/>
                                </list>
                            </field>
                        </page>
                        <page string="當期帳單" name="current_schedules">
                            <div class="o_ggandy_hint">
                                <i class="fa fa-info-circle" role="img" title="說明"/>
                                <div>
                                    <div>本月各房間的<strong>租金期次</strong>，只供檢視。</div>
                                    <div>要開帳單或改金額，請到該房客租約的「租金期次」分頁。</div>
                                </div>
                            </div>
                            <field name="current_schedule_ids" readonly="1" nolabel="1">
                                <list default_order="unit_id" decoration-danger="collection_state == 'overdue'" decoration-success="collection_state == 'paid'">
                                    <field name="unit_id" context="{'ggandy_unit_short_name': True}" width="110px"/>
                                    <field name="tenant_id"/>
                                    <field name="due_date"/>
                                    <field name="rent_amount" sum="租金"/>
                                    <field name="management_fee" optional="show" sum="管理費"/>
                                    <field name="electricity_amount" optional="show" sum="電費"/>
                                    <field name="water_amount" optional="show" sum="水費"/>
                                    <field name="total_amount" sum="應收合計"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="collection_state" widget="badge"
                                           decoration-danger="collection_state == 'overdue'"
                                           decoration-success="collection_state == 'paid'"
                                           decoration-warning="collection_state == 'partial'"/>
                                    <field name="invoice_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="水電表維護" name="meter_readings">
                            <div class="o_ggandy_hint">
                                <i class="fa fa-info-circle" role="img" title="說明"/>
                                <div>
                                    <div>本月帳單收上個月電費，所以<strong>電表月份是上個月</strong>；抄表度數請填該月月底讀數。</div>
                                    <div><strong>水費</strong>是這個月帳單收的固定水費，只改這一期；要改之後每個月的金額請到房間設定。</div>
                                    <div>填好會帶到下一期並更新草稿帳單，已過帳不能改。過去月份請到房間查看。</div>
                                </div>
                            </div>
                            <field name="current_meter_schedule_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0" default_order="unit_id">
                                    <field name="unit_id" context="{'ggandy_unit_short_name': True}" width="110px"/>
                                    <field name="meter_month" width="90px"/>
                                    <field name="period_month" optional="hide" width="90px"/>
                                    <field name="tenant_id" optional="hide"/>
                                    <field name="electricity_billing_type" column_invisible="True"/>
                                    <field name="electricity_prev_reading" string="上期度數" optional="show" width="100px"
                                           invisible="electricity_billing_type != 'metered'"/>
                                    <field name="electricity_curr_reading" string="抄表度數" width="100px"
                                           invisible="electricity_billing_type != 'metered'" readonly="invoice_state == 'posted'"/>
                                    <field name="electricity_usage" optional="show" width="90px"
                                           invisible="electricity_billing_type != 'metered'"/>
                                    <field name="electricity_amount" width="100px"/>
                                    <field name="water_billing_type" column_invisible="True"/>
                                    <field name="water_fixed_fee" string="水費" width="100px"
                                           invisible="water_billing_type != 'fixed'" readonly="invoice_state == 'posted'"/>
                                    <field name="water_curr_reading" string="水錶度數" optional="hide" width="100px"
                                           invisible="water_billing_type != 'metered'" readonly="invoice_state == 'posted'"/>
                                    <field name="note" string="備註" optional="show" placeholder="例如：換電錶"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="invoice_state" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="備註" name="notes">
                            <field name="note" placeholder="物件設備、管理注意事項、門禁資訊等……"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ggandy_property" model="ir.actions.act_window">
        <field name="name">物件</field>
        <field name="res_model">ggandy.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ggandy_property_search"/>
        <field name="context">{'search_default_group_manager': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">建立第一個包租或代管物件</p>
            <p>先登記房東與地址，再加入房間。</p>
        </field>
    </record>
</odoo>
