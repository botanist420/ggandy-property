<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggandy_property_form_preparation" model="ir.ui.view">
        <field name="name">ggandy.property.form.preparation</field>
        <field name="model">ggandy.property</field>
        <field name="inherit_id" ref="ggandy_property_management.view_ggandy_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="preparation_project_id" invisible="1"/>
                    <button name="action_start_preparation" string="開始整備" type="object" class="btn-primary"
                            invisible="management_mode != 'master_lease' or preparation_project_id"
                            groups="ggandy_property_management.group_property_manager"
                            help="建立「整備-物件名稱」專案（可計費、客戶為主要房東、同名分析帳戶），並帶入整備階段與任務。每個物件只能建立一次。"/>
                    <button name="action_create_preparation_purchase" string="整備採購" type="object" class="btn-secondary"
                            invisible="management_mode != 'master_lease' or not preparation_project_id"
                            groups="purchase.group_purchase_user"
                            help="開啟新的採購單，專案已帶入這個物件的整備專案，成本會自動記到同名分析帳戶。"/>
                    <button name="action_sync_stock_locations" string="同步庫存位置" type="object" class="btn-secondary"
                            invisible="management_mode != 'master_lease' or not preparation_project_id"
                            groups="ggandy_property_management.group_property_manager"
                            help="在總倉底下補齊這個物件與各出租單位的庫存位置，已經存在的會直接沿用，不會重複建立。新增出租單位後按一次即可。"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_preparation_project" type="object" class="oe_stat_button" icon="fa-tasks"
                        invisible="not preparation_project_id" groups="project.group_project_user">
                    <field name="preparation_task_count" widget="statinfo" string="整備專案"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='owner_payment_day']" position="after">
                <field name="preparation_project_id" invisible="not preparation_project_id"
                       groups="project.group_project_user"/>
                <field name="stock_location_id" invisible="not stock_location_id"
                       groups="stock.group_stock_multi_locations"/>
            </xpath>
            <xpath expr="//field[@name='unit_ids']/list/field[@name='state']" position="after">
                <field name="stock_location_id" optional="hide" groups="stock.group_stock_multi_locations"/>
            </xpath>
        </field>
    </record>

    <record id="view_ggandy_property_search_preparation" model="ir.ui.view">
        <field name="name">ggandy.property.search.preparation</field>
        <field name="model">ggandy.property</field>
        <field name="inherit_id" ref="ggandy_property_management.view_ggandy_property_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='agency']" position="after">
                <filter name="has_preparation_project" string="整備中" domain="[('preparation_project_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
